# Required - your bot's token from the Discord Developer Portal.
DISCORD_TOKEN=

# Recommended - the only servers the bot works in, as comma-separated server
# IDs. If anyone adds it to another server, it leaves right away. (Discord:
# Settings > Advanced > Developer Mode, then right-click the server icon >
# Copy Server ID.) Leave empty to let it work in any server.
ALLOWED_GUILD_IDS=

# Channel IDs where shared links get copied into category threads ("TikTok
# Videos", "YouTube Videos", "X Posts", ...). Comma-separated, one channel per
# server; each server's links only go to its own channel. Leave empty to turn
# this off. (Discord: Settings > Advanced > Developer Mode, then right-click
# the channel > Copy Channel ID.)
LINK_ARCHIVE_CHANNEL_IDS=

# For live tests (npm run test:live): a private test channel and a webhook in
# it. Posts from this webhook are handled like normal messages but never archived.
# TEST_CHANNEL_ID=
# TEST_WEBHOOK_URL=

# Everything below is optional; the defaults are shown.
# FIX_DOMAIN=fxtwitter.com
# TIKTOK_FIX_DOMAIN=tnktok.com
# (a.tnktok.com also shows the TikTok's caption)
# INSTAGRAM_FIX_DOMAIN=instagramfix.com

# Comma-separated list of paywalled news domains. Setting this REPLACES the
# built-in list in index.js (~75 major outlets) rather than adding to it.
# PAYWALL_DOMAINS=nytimes.com,wsj.com,ft.com
# PAYWALL_FIX_URL=https://www.removepaywall.com/search?url=
# ARCHIVE_PH_ENABLED=true
# ARCHIVE_PH_TIMEOUT_MS=8000

# Who can use /restart, as comma-separated user IDs. The app's owner in the
# Developer Portal (or its team) always can.
# BOT_OWNER_IDS=
